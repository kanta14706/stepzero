{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stepzero.example/stations.schema.json",
  "title": "StepZero station list (data/build/stations.json)",
  "description": "Stations the journey planner can start or end at. Written by importer/graph/stations.py from the Toei GTFS.",
  "type": "object",
  "required": ["schemaVersion", "feed", "stations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "feed": { "type": "string" },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "otpId", "name", "lat", "lon", "lines", "tier"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "GTFS stop_id of the station (parent station, or the stop when it has none)." },
          "otpId": { "type": "string", "description": "The id OpenTripPlanner uses: <feed id>:<stop_id>." },
          "code": { "type": "string", "description": "Station number, e.g. E-20." },
          "name": { "$ref": "#/$defs/names" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "name": { "$ref": "#/$defs/names" },
                "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
              }
            }
          },
          "tier": { "enum": [1, 2], "description": "2 when a station graph with in-station detail exists." }
        }
      }
    }
  },
  "$defs": {
    "names": {
      "type": "object",
      "required": ["ja"],
      "additionalProperties": { "type": "string" },
      "properties": { "ja": { "type": "string" }, "en": { "type": "string" } }
    }
  }
}
