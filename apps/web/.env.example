# Copy to .env.development.local for `pnpm dev`. Both values are public (the key is the
# publishable/anon key; RLS decides what it can do). Without them the app runs without live
# outage reports. `supabase start` (or `supabase status`) prints the local values.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Journey planner: OpenTripPlanner's GraphQL endpoint. Leave unset in development: the dev server
# forwards /otp to OTP_URL (default http://localhost:8080).
# VITE_OTP_URL=https://otp.example.org/otp/gtfs/v1
